# ==============================================================================
# Cost-Aware Multi-Tier Cascading LLM Router Configuration
# ==============================================================================

# Default Provider Mode:
# Options: "gemini" (Live Google AI Studio Free Tier), "groq" (Free Tier), "mistral", "anthropic", "openai", "mock" (offline simulation)
DEFAULT_PROVIDER=gemini

# Threshold for Tier 1 -> Tier 2 escalation (0.0 to 1.0)
# If Tier 1 confidence < CONFIDENCE_THRESHOLD, request escalates to Tier 2 with reason="low_confidence"
CONFIDENCE_THRESHOLD=0.75

# ------------------------------------------------------------------------------
# FREE TIER PROVIDERS (Recommended for zero-cost live testing)
# ------------------------------------------------------------------------------

# 1. Google Gemini (Google AI Studio provides a free tier with rate limits)
# Get key from: https://aistudio.google.com/app/apikey
# Tier 1 (Fast & Cheap): gemini-1.5-flash / gemini-2.5-flash
# Tier 2 (Frontier): gemini-1.5-pro / gemini-2.5-pro
GEMINI_API_KEY=

# 2. Groq (Free tier available for high-speed open-weights inference)
# Get key from: https://console.groq.com/keys
# Tier 1 (Fast & Cheap): llama-3.1-8b-instant
# Tier 2 (Frontier): llama-3.3-70b-versatile
GROQ_API_KEY=

# 3. Mistral AI (Free tier / trial available)
# Get key from: https://console.mistral.ai/
# Tier 1 (Fast & Cheap): mistral-small-latest
# Tier 2 (Frontier): mistral-large-latest
MISTRAL_API_KEY=

# ------------------------------------------------------------------------------
# COMMERCIAL / PAID PROVIDERS (No free tier - requires prepaid credit)
# ------------------------------------------------------------------------------

# 4. Anthropic Claude (Requires minimum $5 paid account)
# Tier 1: claude-3-5-haiku-20241022 ($0.80 / $4.00 per 1M tokens)
# Tier 2: claude-3-5-sonnet-20241022 ($3.00 / $15.00 per 1M tokens)
ANTHROPIC_API_KEY=

# 5. OpenAI (Requires paid API account)
# Tier 1: gpt-4o-mini ($0.15 / $0.60 per 1M tokens)
# Tier 2: gpt-4o ($2.50 / $10.00 per 1M tokens)
OPENAI_API_KEY=

# Server Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
