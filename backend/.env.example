# ==============================================================================
# Cost-Aware Multi-Tier Cascading LLM Router Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL required)
# ------------------------------------------------------------------------------
# Format: postgresql+asyncpg://user:password@host:5432/cost_aware
DATABASE_URL=

# ------------------------------------------------------------------------------
# DEFAULT PROVIDER
# Options: "gemini", "groq", "mistral", "anthropic", "openai", "mock"
# Leave empty to auto-detect from available API keys.
# ------------------------------------------------------------------------------
DEFAULT_PROVIDER=

# ------------------------------------------------------------------------------
# ROUTING
# ------------------------------------------------------------------------------
# Confidence threshold for Tier 1 -> Tier 2 escalation (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.75

# Pareto-optimal model selection weights (must sum to 1.0)
PARETO_QUALITY_WEIGHT=0.45
PARETO_LATENCY_WEIGHT=0.30
PARETO_COST_WEIGHT=0.25

# ------------------------------------------------------------------------------
# PROVIDER API KEYS
# ------------------------------------------------------------------------------

# 1. Google Gemini (Free Tier)
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Groq (Free Tier)
# Get key from: https://console.groq.com/keys
GROQ_API_KEY=

# 3. Mistral AI (Free Tier)
# Get key from: https://console.mistral.ai/
MISTRAL_API_KEY=

# 4. Anthropic Claude (Paid only, min $5 balance)
# Get key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# 5. OpenAI (Paid only)
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# QUALITY EVALUATION
# ------------------------------------------------------------------------------
# Toggle hybrid quality evaluation (deterministic + LLM judge)
QUALITY_EVALUATION_ENABLED=true

# LLM judge used for quality scoring
JUDGE_MODEL_PROVIDER=anthropic
JUDGE_MODEL_NAME=claude-3-5-haiku-20241022

# ------------------------------------------------------------------------------
# QUALITY RECOVERY
# ------------------------------------------------------------------------------
# Toggle quality recovery (revise/escalate when quality is low)
QUALITY_RECOVERY_ENABLED=true

# Score >= accept_threshold: accept as-is
QUALITY_ACCEPT_THRESHOLD=0.90

# Score >= revise_threshold but < accept_threshold: attempt one revision
QUALITY_REVISE_THRESHOLD=0.80

# Dedicated revision model (empty = reuse current model)
QUALITY_REVISION_MODEL=

# Maximum revision attempts before escalating
QUALITY_MAX_REVISIONS=1

# ------------------------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------------------------
# Fernet encryption key for storing API keys in the database
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_SECRET_KEY=
